# Copy to .env and `set -a; source .env` (or export in your shell profile).
# Everything is optional -- with no keys the tool still works using rule-based packets.

# Writing model (any OpenAI-compatible endpoint also works)
FILLDESK_LLM_PROVIDER=            # auto | openai | anthropic | gemini | ollama | none
FILLDESK_LLM_BASE_URL=            # https://api.openai.com/v1 | http://localhost:11434
FILLDESK_LLM_MODEL=               # gpt-4o-mini | claude-sonnet-4-20250514 | llama3.1
FILLDESK_LLM_API_KEY=

# Standard provider variables are also picked up automatically
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Server
FILLDESK_PORT=8756
FILLDESK_HOST=127.0.0.1           # keep loopback unless you know why you are changing it
# FILLDESK_DATA=/path/to/elsewhere
# FILLDESK_VERBOSE=1
# FILLDESK_OPEN_API=1             # turn off the token check; only on a machine you own
